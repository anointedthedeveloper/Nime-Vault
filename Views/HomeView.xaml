<UserControl x:Class="NimeVault.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NimeVault.Views"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,48">
        <StackPanel>

            <!-- ── Spotlight Hero ────────────────────────────────────────── -->
            <Grid Height="480" ClipToBounds="True">

                <!-- Background image (CurrentSpotlight) -->
                <Border ClipToBounds="True"
                        Visibility="{Binding CurrentSpotlight, Converter={StaticResource NullToVisibility}}">
                    <Image Source="{Binding CurrentSpotlight.BackgroundUrl, Converter={StaticResource HttpImage}}"
                           Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Gradients -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Color="#BB000000" Offset="0"/>
                            <GradientStop Color="#55000000" Offset="0.5"/>
                            <GradientStop Color="#11000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border VerticalAlignment="Bottom" Height="240">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="{DynamicResource BackgroundPrimaryColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Info -->
                <Grid VerticalAlignment="Bottom" Margin="56,0,56,52"
                      Visibility="{Binding CurrentSpotlight, Converter={StaticResource NullToVisibility}}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CurrentSpotlight.Genres, Converter={StaticResource GenreListToString}}"
                                   Foreground="#A78BFA" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentSpotlight.Title}"
                                   Foreground="White" FontSize="38" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="44">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="8" ShadowDepth="2"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentSpotlight.Description}"
                                   Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap"
                                   MaxHeight="52" LineHeight="20" Margin="0,0,0,20"/>
                        <Button Style="{StaticResource PrimaryButton}" Padding="22,11" HorizontalAlignment="Left"
                                Command="{Binding ViewDetailsCommand}"
                                CommandParameter="{Binding CurrentSpotlight}">
                            <TextBlock Text="▶  View Details" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Prev arrow -->
                <Button VerticalAlignment="Center" HorizontalAlignment="Left"
                        Margin="12,0" Width="38" Height="38"
                        Background="#55000000" BorderThickness="0"
                        Command="{Binding SpotlightPrevCommand}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="19">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="‹" Foreground="White" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                </Button>

                <!-- Next arrow -->
                <Button VerticalAlignment="Center" HorizontalAlignment="Right"
                        Margin="0,0,12,0" Width="38" Height="38"
                        Background="#55000000" BorderThickness="0"
                        Command="{Binding SpotlightNextCommand}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="19">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="›" Foreground="White" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                </Button>

                <!-- Dot indicators -->
                <ItemsControl ItemsSource="{Binding SpotlightAnime}"
                              VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="7" Height="7" Margin="3,0" Fill="#88FFFFFF"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading overlay -->
                <Border Background="#CC0F1117"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Loading…" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ── Latest Episodes ───────────────────────────────────────── -->
            <StackPanel Margin="40,36,40,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="Latest Episodes" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock Text="See all →" Foreground="{StaticResource BrandPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding PopularAnime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AnimeCard Margin="0,0,16,20" AnimeData="{Binding}"
                                             SelectCommand="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Recently Updated ──────────────────────────────────────── -->
            <StackPanel Margin="40,28,40,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="Recently Updated" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock Text="See all →" Foreground="{StaticResource BrandPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding RecentlyAdded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AnimeCard Margin="0,0,16,20" AnimeData="{Binding}"
                                             SelectCommand="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
