<UserControl x:Class="NimeVault.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NimeVault.Views"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,48">
        <StackPanel>

            <!-- ── Hero Section ──────────────────────────────────────────── -->
            <Grid MinHeight="420" Visibility="{Binding FeaturedAnime, Converter={StaticResource NullToVisibility}}">
                <!-- Background Image -->
                <Border ClipToBounds="True">
                    <Image Source="{Binding FeaturedAnime.BackgroundUrl}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Side gradient -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Color="#D9000000" Offset="0"/>
                            <GradientStop Color="#88000000" Offset="0.55"/>
                            <GradientStop Color="#11000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Bottom fade -->
                <Border VerticalAlignment="Bottom" Height="200">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF0F1117" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Content -->
                <Grid Margin="56,0,0,48" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="620">
                    <StackPanel>
                        <!-- Genre tags -->
                        <TextBlock Text="{Binding FeaturedAnime.Genres, Converter={StaticResource GenreListToString}}"
                                   Foreground="#A78BFA" FontSize="11" FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <!-- Title -->
                        <TextBlock Text="{Binding FeaturedAnime.Title}"
                                   Foreground="White" FontSize="40" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                   LineHeight="46">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="8" ShadowDepth="2"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Alt Title -->
                        <TextBlock Text="{Binding FeaturedAnime.AlternativeTitle}"
                                   Foreground="#94A3B8" FontSize="14" Margin="0,0,0,12"/>

                        <!-- Meta row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" Background="#22FFFFFF">
                                <TextBlock Text="{Binding FeaturedAnime.Year}" Foreground="#CBD5E1" FontSize="12"/>
                            </Border>
                            <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" Background="#22FFFFFF">
                                <TextBlock Text="{Binding FeaturedAnime.Status}" Foreground="#CBD5E1" FontSize="12"/>
                            </Border>
                            <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" Background="#22F59E0B">
                                <TextBlock Text="{Binding FeaturedAnime.Rating, Converter={StaticResource RatingToStars}}"
                                           Foreground="#F59E0B" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="4" Padding="8,3" Background="#22FFFFFF">
                                <TextBlock Text="{Binding FeaturedAnime.TotalEpisodes, StringFormat='{}{0} Episodes'}"
                                           Foreground="#CBD5E1" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Text="{Binding FeaturedAnime.Description}"
                                   Foreground="#CBD5E1" FontSize="13.5" TextWrapping="Wrap"
                                   MaxHeight="60" LineHeight="21" Margin="0,0,0,24"/>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ViewDetailsCommand}"
                                    CommandParameter="{Binding FeaturedAnime}"
                                    Padding="24,12" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶  View Details" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddToQueueCommand}"
                                    CommandParameter="{Binding FeaturedAnime}"
                                    Padding="24,12"
                                    Foreground="White"
                                    BorderBrush="#55FFFFFF">
                                <TextBlock Text="+ Add to Queue" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Loading state -->
            <Border Height="200" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Loading..." HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15"/>
                </StackPanel>
            </Border>

            <!-- ── Popular Anime ──────────────────────────────────────────── -->
            <StackPanel Margin="40,36,40,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="Popular Anime" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock Text="See all →" Foreground="{StaticResource BrandPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Cursor="Hand"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding PopularAnime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AnimeCard Margin="0,0,16,20"
                                             AnimeData="{Binding}"
                                             SelectCommand="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Recently Added ─────────────────────────────────────────── -->
            <StackPanel Margin="40,28,40,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="Recently Added" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock Text="See all →" Foreground="{StaticResource BrandPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Cursor="Hand"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding RecentlyAdded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AnimeCard Margin="0,0,16,20"
                                             AnimeData="{Binding}"
                                             SelectCommand="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
