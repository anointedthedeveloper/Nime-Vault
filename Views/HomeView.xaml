<UserControl x:Class="NimeVault.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NimeVault.Views"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Hero Section -->
            <Grid Height="440" Visibility="{Binding FeaturedAnime, Converter={StaticResource NullToVisibility}}">
                <!-- Background Image -->
                <Border ClipToBounds="True">
                    <Image Source="{Binding FeaturedAnime.BackgroundUrl}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Gradient Overlay -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#88000000" Offset="0.5"/>
                            <GradientStop Color="#22000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Bottom fade -->
                <Border VerticalAlignment="Bottom" Height="160">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF0F1117" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Content -->
                <Grid Margin="60,0,0,40" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="600">
                    <StackPanel>
                        <!-- Genres -->
                        <TextBlock Text="{Binding FeaturedAnime.Genres, Converter={StaticResource GenreListToString}}"
                                   Foreground="#B0C4DE" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <!-- Title -->
                        <TextBlock Text="{Binding FeaturedAnime.Title}"
                                   Foreground="White" FontSize="36" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <!-- Alt Title -->
                        <TextBlock Text="{Binding FeaturedAnime.AlternativeTitle}"
                                   Foreground="#94A3B8" FontSize="14" Margin="0,0,0,10"/>

                        <!-- Meta -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding FeaturedAnime.Year}" Foreground="#94A3B8" FontSize="13" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding FeaturedAnime.Status}" Foreground="#94A3B8" FontSize="13" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding FeaturedAnime.Rating, Converter={StaticResource RatingToStars}}"
                                       Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding FeaturedAnime.TotalEpisodes, StringFormat='{}{0} Episodes'}"
                                       Foreground="#94A3B8" FontSize="13"/>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Text="{Binding FeaturedAnime.Description}"
                                   Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap"
                                   MaxHeight="56" LineHeight="20" Margin="0,0,0,20"/>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ViewDetailsCommand}"
                                    CommandParameter="{Binding FeaturedAnime}"
                                    Padding="20,10" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶  View Details" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddToQueueCommand}"
                                    CommandParameter="{Binding FeaturedAnime}"
                                    Padding="20,10"
                                    Foreground="White"
                                    BorderBrush="#4A5568">
                                <TextBlock Text="+ Add to Queue" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Loading state -->
            <Border Height="200" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
            </Border>

            <!-- Popular Anime Section -->
            <StackPanel Margin="40,32,40,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Popular Anime" Style="{StaticResource SectionHeader}"/>

                <ItemsControl ItemsSource="{Binding PopularAnime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AnimeCard Margin="0,0,16,16"
                                             AnimeData="{Binding}"
                                             SelectCommand="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Recently Added Section -->
            <StackPanel Margin="40,24,40,40"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Recently Added" Style="{StaticResource SectionHeader}"/>

                <ItemsControl ItemsSource="{Binding RecentlyAdded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AnimeCard Margin="0,0,16,16"
                                             AnimeData="{Binding}"
                                             SelectCommand="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
