<UserControl x:Class="NimeVault.Views.DownloadCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NimeVault.Models">

    <Border Style="{StaticResource HoverCardStyle}" Padding="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Poster -->
            <Border Grid.Column="0" Width="52" Height="74" CornerRadius="8" ClipToBounds="True">
                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
            </Border>

            <!-- Details -->
            <StackPanel Grid.Column="1" Margin="16,0,16,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="{Binding AnimeTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    <Border CornerRadius="5" Padding="6,2" Margin="8,0,0,0" Background="#EDE9FE">
                        <TextBlock Text="{Binding Language}" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding EpisodeNumber, StringFormat='Episode {0}'}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,7"/>

                <TextBlock Text="{Binding Status, Converter={StaticResource DownloadStatusToText}}"
                           Foreground="{Binding Status, Converter={StaticResource DownloadStatusToColor}}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"/>

                <!-- Progress Bar -->
                <Grid Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Style="{StaticResource DownloadProgress}" Value="{Binding Progress}" Maximum="100"/>
                </Grid>
                <Grid Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Style="{StaticResource DownloadProgress}" Value="{Binding Progress}" Maximum="100"
                                 Foreground="{StaticResource WarningBrush}"/>
                </Grid>

                <!-- Stats row -->
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0">
                        <Run Text="{Binding DownloadedText, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"
                               Text="{Binding SpeedText}"/>
                    <TextBlock Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                        <Run Text="ETA "/>
                        <Run Text="{Binding EtaText}"/>
                    </TextBlock>
                    <TextBlock Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                        <Run Text="{Binding ProgressText}"/>
                        <Run Text=" · Paused"/>
                    </TextBlock>
                    <TextBlock Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{StaticResource ErrorBrush}" FontSize="11"
                               Text="{Binding ErrorMessage}"/>
                    <TextBlock Visibility="{Binding IsRetrying, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                        <Run Text="Retry attempt "/>
                        <Run Text="{Binding RetryCount}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                <Button Style="{StaticResource SmallButton}"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Command="{Binding PauseCommand}"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,6">
                    <TextBlock Text="⏸ Pause" FontSize="11"/>
                </Button>
                <Button Style="{StaticResource SmallButton}"
                        Command="{Binding ResumeCommand}"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,6">
                    <TextBlock Text="▶ Resume" FontSize="11"/>
                </Button>
                <Button Style="{StaticResource SmallButton}"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,6">
                    <TextBlock Text="↺ Retry" FontSize="11"/>
                </Button>
                <Button Style="{StaticResource DangerButton}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="✕ Cancel" FontSize="11"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
