<UserControl x:Class="NimeVault.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#000000">

    <Grid>
        <!-- Loading overlay -->
        <Border Background="#CC000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Resolving stream..." Foreground="White" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Starting headless browser to bypass VRF protection…"
                           Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Error overlay -->
        <Border Background="#CC000000"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="⚠ Stream Error" Foreground="#EF4444" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#CBD5E1" FontSize="13"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" Margin="0,0,10,0">
                        <TextBlock Text="Retry"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CloseCommand}">
                        <TextBlock Text="Close"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Close button (always visible) -->
        <Button Style="{StaticResource IconButton}"
                Command="{Binding CloseCommand}"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,12,16,0" Panel.ZIndex="20"
                ToolTip="Close player">
            <Viewbox Width="20" Height="20">
                <Canvas Width="24" Height="24">
                    <Line X1="4" Y1="4" X2="20" Y2="20" Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="20" Y1="4" X2="4" Y2="20" Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Title bar -->
        <Border VerticalAlignment="Top" Height="44" Panel.ZIndex="5"
                Visibility="{Binding HasStream, Converter={StaticResource BoolToVisibility}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC000000" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock VerticalAlignment="Center" Margin="16,0"
                       Foreground="White" FontSize="13" FontWeight="SemiBold">
                <Run Text="{Binding AnimeTitle}"/>
                <Run Text=" — Episode "/>
                <Run Text="{Binding EpisodeNumber}"/>
                <Run Text=" ["/>
                <Run Text="{Binding Language}"/>
                <Run Text="]"/>
            </TextBlock>
        </Border>

        <!-- WebView2 HLS player -->
        <wv2:WebView2 x:Name="PlayerWebView"
                      Visibility="{Binding HasStream, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
