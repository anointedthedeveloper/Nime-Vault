<UserControl x:Class="NimeVault.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Logo -->
            <Border Width="72" Height="72" CornerRadius="16"
                    Background="{StaticResource BrandPrimaryBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="36"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Lock Icon -->
            <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Canvas Width="24" Height="24">
                    <Path Data="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                    <Path Data="M8 11V7a4 4 0 0 1 8 0v4"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="10" Canvas.Top="14" Width="4" Height="4"
                             Fill="{DynamicResource TextSecondaryBrush}"/>
                </Canvas>
            </Viewbox>

            <!-- Title -->
            <TextBlock Text="Nime Vault is locked" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="Click unlock to continue" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <!-- Unlock Button -->
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding UnlockCommand}"
                    HorizontalAlignment="Center"
                    Padding="48,12">
                <TextBlock Text="Unlock" FontSize="14" FontWeight="SemiBold"/>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
