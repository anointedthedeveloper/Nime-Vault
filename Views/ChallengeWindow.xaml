<Window x:Class="NimeVault.Views.ChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Verifying with AnimePahe..." Width="520" Height="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Margin="12,8" TextWrapping="Wrap"
                   Text="AnimePahe is checking your browser. This window closes by itself; tick the box if one appears."/>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
    </Grid>
</Window>
