<Window x:Class="NimeVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NimeVault.Views"
        xmlns:conv="clr-namespace:NimeVault.Converters"
        Title="Nime Vault"
        MinWidth="1024" MinHeight="640"
        Width="1366" Height="768"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource NavBorderBrush}"
                BorderThickness="0,0,0,1"
                Height="56"
                Visibility="{Binding IsLockPage, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Icons/logo.png"
                           Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="Nime Vault" FontSize="15.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Nav -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateHomeCommand}">
                        <Button.Tag><conv:ActiveTagConverter/></Button.Tag>
                        <TextBlock Text="Home" Foreground="{Binding IsHomePage, Converter={StaticResource BoolToActiveNav}}"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateSearchCommand}">
                        <TextBlock Text="Search" Foreground="{Binding IsSearchPage, Converter={StaticResource BoolToActiveNav}}"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateDownloadsCommand}">
                        <TextBlock Text="Downloads" Foreground="{Binding IsDownloadsPage, Converter={StaticResource BoolToActiveNav}}"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateQueueCommand}">
                        <TextBlock Text="Queue" Foreground="{Binding IsQueuePage, Converter={StaticResource BoolToActiveNav}}"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateSettingsCommand}">
                        <TextBlock Text="Settings" Foreground="{Binding IsSettingsPage, Converter={StaticResource BoolToActiveNav}}"/>
                    </Button>
                </StackPanel>

                <!-- Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding NavigateSearchIconCommand}" ToolTip="Search">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                         Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <Line X1="15.5" Y1="15.5" X2="21" Y2="21"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Theme Toggle -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle theme" Margin="4,0">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <!-- Moon (show in light mode) -->
                                <Path Visibility="{Binding IsDarkTheme, Converter={StaticResource InverseBoolToVisibility}}"
                                      Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                      Fill="Transparent" StrokeLineJoin="Round"/>
                                <!-- Sun (show in dark mode) -->
                                <Path Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}"
                                      Data="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42M17 12a5 5 0 1 1-10 0 5 5 0 0 1 10 0z"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                      Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Lock -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleLockCommand}" ToolTip="Lock">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Fill="Transparent"/>
                                <Path Data="M8 11V7a4 4 0 0 1 8 0v4"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                      Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page Content -->
        <Grid Grid.Row="1">
            <views:HomeView DataContext="{Binding HomeVM}"
                            Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVisibility}}"/>
            <views:SearchView DataContext="{Binding SearchVM}"
                              Visibility="{Binding IsSearchPage, Converter={StaticResource BoolToVisibility}}"/>
            <views:AnimeDetailsView DataContext="{Binding AnimeDetailsVM}"
                                    Visibility="{Binding IsDetailsPage, Converter={StaticResource BoolToVisibility}}"/>
            <views:DownloadsView DataContext="{Binding DownloadsVM}"
                                 Visibility="{Binding IsDownloadsPage, Converter={StaticResource BoolToVisibility}}"/>
            <views:QueueView DataContext="{Binding QueueVM}"
                             Visibility="{Binding IsQueuePage, Converter={StaticResource BoolToVisibility}}"/>
            <views:SettingsView DataContext="{Binding SettingsVM}"
                                Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}"/>
            <views:LockView DataContext="{Binding LockVM}"
                            Visibility="{Binding IsLockPage, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Toast Host -->
        <views:ToastHost x:Name="ToastHostControl"
                         Grid.Row="0" Grid.RowSpan="2"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Right"
                         Margin="0,0,24,24"
                         Panel.ZIndex="999"/>
    </Grid>
</Window>
