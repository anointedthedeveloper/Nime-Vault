<Window x:Class="NimeVault.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NimeVault.Views"
        Title="Nime Vault"
        MinWidth="1100" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ambient blobs -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="600" Height="600" Canvas.Left="-100" Canvas.Top="-200" Opacity="0.04">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="500" Height="500" Canvas.Right="-80" Canvas.Bottom="-100" Opacity="0.035">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#EC4899" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- ── Nav Bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource NavBorderBrush}"
                BorderThickness="0,0,0,1" Height="56">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.07" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,9,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="pack://application:,,,/Resources/Icons/logo.png" Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Nime Vault" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nav pills — Tag="Active" drives the purple pill style -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Tag="{Binding HomeNavTag}"
                            Command="{Binding NavigateHomeCommand}">
                        <TextBlock Text="Home" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding SearchNavTag}"
                            Command="{Binding NavigateSearchCommand}" Margin="2,0">
                        <TextBlock Text="Search" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding BrowseNavTag}"
                            Command="{Binding NavigateBrowseCommand}" Margin="2,0">
                        <TextBlock Text="Browse" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding AZNavTag}"
                            Command="{Binding NavigateAZCommand}" Margin="2,0">
                        <TextBlock Text="A-Z" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding DownloadsNavTag}"
                            Command="{Binding NavigateDownloadsCommand}" Margin="2,0">
                        <TextBlock Text="Downloads" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding QueueNavTag}"
                            Command="{Binding NavigateQueueCommand}" Margin="2,0">
                        <TextBlock Text="Queue" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding SettingsNavTag}"
                            Command="{Binding NavigateSettingsCommand}" Margin="2,0">
                        <TextBlock Text="Settings" FontSize="13"/>
                    </Button>
                </StackPanel>

                <!-- Right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Button Style="{StaticResource IconButton}" Command="{Binding NavigateSearchIconCommand}" ToolTip="Search">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                         Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <Line X1="15.5" Y1="15.5" X2="21" Y2="21"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding IsDarkTheme, Converter={StaticResource ThemeToggleTip}}" Margin="2,0,0,0">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Visibility="{Binding IsDarkTheme, Converter={StaticResource InverseBoolToVisibility}}"
                                      Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Fill="Transparent"/>
                                <Path Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}"
                                      Data="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42M17 12a5 5 0 1 1-10 0 5 5 0 0 1 10 0z"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Pages ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <views:HomeView      DataContext="{Binding HomeVM}"
                Visibility="{Binding DataContext.IsHomePage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:SearchView    DataContext="{Binding SearchVM}"
                Visibility="{Binding DataContext.IsSearchPage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:BrowseView    DataContext="{Binding BrowseVM}"
                Visibility="{Binding DataContext.IsBrowsePage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:AZListView    DataContext="{Binding AZListVM}"
                Visibility="{Binding DataContext.IsAZPage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:AnimeDetailsView DataContext="{Binding AnimeDetailsVM}"
                Visibility="{Binding DataContext.IsDetailsPage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:DownloadsView DataContext="{Binding DownloadsVM}"
                Visibility="{Binding DataContext.IsDownloadsPage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:QueueView     DataContext="{Binding QueueVM}"
                Visibility="{Binding DataContext.IsQueuePage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:SettingsView  DataContext="{Binding SettingsVM}"
                Visibility="{Binding DataContext.IsSettingsPage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
            <views:PlayerView    DataContext="{Binding PlayerVM}"
                Visibility="{Binding DataContext.IsPlayerPage, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="100"/>
        </Grid>

        <views:ToastHost x:Name="ToastHostControl"
                         Grid.Row="0" Grid.RowSpan="2"
                         VerticalAlignment="Bottom" HorizontalAlignment="Right"
                         Margin="0,0,24,24" Panel.ZIndex="999"/>
    </Grid>
</Window>
