<UserControl x:Class="NimeVault.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NimeVault.Views"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40">

            <!-- Search Header -->
            <TextBlock Text="Search" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/>

            <!-- Search Box -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Background="{DynamicResource InputBackgroundBrush}"
                    Margin="0,0,0,32">
                <Grid Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Icon -->
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="16,0,0,0">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                     Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                            <Line X1="15.5" Y1="15.5" X2="21" Y2="21"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Input -->
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputStyle}"
                             BorderThickness="0" Background="Transparent"
                             Padding="12,0"
                             FontSize="15"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Clear -->
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ClearCommand}"
                            Padding="8,0"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Clear">
                        <TextBlock Text="✕" FontSize="13"/>
                    </Button>

                    <!-- Search Button -->
                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"
                            Margin="0,8,8,8"
                            Padding="20,0">
                        <TextBlock Text="Search"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Loading -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Height="120">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Searching..." Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Error -->
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Padding="24" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Something went wrong" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="Try Again"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Empty state (searched but no results) -->
            <Border Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibility}}"
                    Height="200">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No results found" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different search term" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Initial empty state -->
            <Border Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVisibility}}"
                    Height="200">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Search for an anime to get started" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Results -->
            <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20">
                    <Run Text="Search Results"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding SearchResults.Count, Mode=OneWay}"/>
                    <Run Text=" found"/>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,10"
                                    Cursor="Hand"
                                    Padding="0">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectAnimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Poster -->
                                    <Border Grid.Column="0" ClipToBounds="True" CornerRadius="10,0,0,10" Width="80" Height="100">
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="16,12,0,12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding AlternativeTitle}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Year}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding TotalEpisodes, StringFormat='{}{0} Episodes'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource SubBadge}"
                                                    Visibility="{Binding HasSub, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="SUB" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                            </Border>
                                            <Border Style="{StaticResource DubBadge}"
                                                    Visibility="{Binding HasDub, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="DUB" FontSize="10" FontWeight="Bold" Foreground="#EC4899"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Rating -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12">
                                        <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStars}}"
                                                   Foreground="#F59E0B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
