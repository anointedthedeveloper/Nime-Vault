<UserControl x:Class="NimeVault.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NimeVault.Views"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Search bar area -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="Auto"/>
            <!-- Results -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Search Bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource NavBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Input wrapper -->
                <Border Grid.Column="0"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search icon -->
                        <Viewbox Grid.Column="0" Width="18" Height="18" Margin="16,0,0,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                         Stroke="{DynamicResource TextSecondaryBrush}"
                                         StrokeThickness="2" Fill="Transparent"/>
                                <Line X1="15.5" Y1="15.5" X2="21" Y2="21"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Text input -->
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource InputStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="12,0"
                                 FontSize="15"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding ClearCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Clear button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearCommand}"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                                Padding="10,0" Margin="0,0,4,0"
                                ToolTip="Clear (Esc)">
                            <TextBlock Text="✕" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search button -->
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"
                        Margin="12,0,0,0"
                        Padding="28,0"
                        Height="48">
                    <TextBlock Text="Search" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Filter / Sort Bar ─────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,10"
                Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Genre filter chips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Filter:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Filter chips — wired to backend later via FilterCommand -->
                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                            Background="{StaticResource BrandPrimaryBrush}">
                        <TextBlock Text="All" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="Action" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="Adventure" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="Fantasy" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="Drama" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="SUB Only" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="DUB Available" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Sort + result count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,16,0"
                               Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding SearchResults.Count, Mode=OneWay}"/>
                        <Run Text=" result(s)"/>
                    </TextBlock>

                    <TextBlock Text="Sort:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Relevance" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="▾" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Results Area ───────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,24,40,40">

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                        Height="200">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Searching..." FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Looking through the catalogue" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.6"/>
                    </StackPanel>
                </Border>

                <!-- Error state -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                        Padding="40" CornerRadius="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Something went wrong" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,20" TextWrapping="Wrap"
                                   MaxWidth="400" TextAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"
                                HorizontalAlignment="Center" Padding="24,9">
                            <TextBlock Text="Try Again"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Initial empty state (not yet searched) -->
                <Border Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVisibility}}"
                        Height="320">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="56" Height="56" Margin="0,0,0,20" Opacity="0.25">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                         Stroke="{DynamicResource TextPrimaryBrush}"
                                         StrokeThickness="2" Fill="Transparent"/>
                                <Line X1="15.5" Y1="15.5" X2="21" Y2="21"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Search for anime" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Type a title, genre, or keyword to get started"
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- No results state -->
                <Border Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibility}}"
                        Height="280">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No results found" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,24" TextAlignment="Center">
                            <Run Text="No anime matched &quot;"/>
                            <Run Text="{Binding SearchQuery, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="&quot;"/>
                        </TextBlock>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}"
                                HorizontalAlignment="Center" Padding="24,9">
                            <TextBlock Text="Clear Search"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Results list -->
                <ItemsControl ItemsSource="{Binding SearchResults}"
                              Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,10"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectAnimeCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Poster -->
                                    <Border Grid.Column="0" ClipToBounds="True"
                                            CornerRadius="10,0,0,10" Height="110">
                                        <Image Source="{Binding PosterUrl}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1"
                                                Margin="20,14,16,14"
                                                VerticalAlignment="Center">

                                        <!-- Title row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <!-- Status pill -->
                                            <Border CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Alt title -->
                                        <TextBlock Text="{Binding AlternativeTitle}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,8"
                                                   Visibility="{Binding AlternativeTitle,
                                                                Converter={StaticResource StringToVisibility}}"/>

                                        <!-- Meta row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Year}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,0,20,0"/>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,0,20,0">
                                                <Run Text="{Binding TotalEpisodes, Mode=OneWay}"/>
                                                <Run Text=" Episodes"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Genres, Converter={StaticResource GenreListToString}}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="280"/>
                                        </StackPanel>

                                        <!-- Sub / Dub badges -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource SubBadge}"
                                                    Visibility="{Binding HasSub,
                                                                 Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="SUB" FontSize="10"
                                                           FontWeight="Bold" Foreground="#7C3AED"/>
                                            </Border>
                                            <Border Style="{StaticResource DubBadge}"
                                                    Visibility="{Binding HasDub,
                                                                 Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="DUB" FontSize="10"
                                                           FontWeight="Bold" Foreground="#EC4899"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Rating + View Details -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,20,0"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStars}}"
                                                   Foreground="#F59E0B" FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,12"/>
                                        <Button Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.SelectAnimeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="14,7">
                                            <TextBlock Text="View Details" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
