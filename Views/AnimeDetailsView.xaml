<UserControl x:Class="NimeVault.Views.AnimeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="LangButtonActive" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,9"/>
        </Style>
        <Style x:Key="LangButtonInactive" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Loading -->
            <Border Height="300" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
            </Border>

            <!-- Content -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">

                <!-- Hero -->
                <Grid Height="380" Visibility="{Binding Anime, Converter={StaticResource NullToVisibility}}">
                    <!-- Background -->
                    <Border ClipToBounds="True">
                        <Image Source="{Binding Anime.BackgroundUrl}" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Border>
                    <!-- Overlay -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#55000000" Offset="0"/>
                                <GradientStop Color="#EE0F1117" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Back Button -->
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding GoBackCommand}"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="32,14,0,0" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Poster + Info -->
                    <Grid Margin="40,0,40,24" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="120" Height="168" CornerRadius="8" ClipToBounds="True" Margin="0,0,24,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="12" ShadowDepth="4"/>
                            </Border.Effect>
                            <Image Source="{Binding Anime.PosterUrl}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Anime.Title}" Foreground="White"
                                       FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Anime.AlternativeTitle}"
                                       Foreground="#94A3B8" FontSize="14" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Anime.Year}" Foreground="#94A3B8" FontSize="13" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding Anime.Status}" Foreground="#94A3B8" FontSize="13" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding Anime.Rating, Converter={StaticResource RatingToStars}}"
                                           Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding Anime.TotalEpisodes, StringFormat='{}{0} Episodes'}"
                                           Foreground="#94A3B8" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Anime.Genres, Converter={StaticResource GenreListToString}}"
                                       Foreground="#B0C4DE" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Details Section -->
                <Grid Margin="40,24,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left -->
                    <StackPanel Grid.Column="0" Margin="0,0,32,0">

                        <!-- Description -->
                        <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Anime.Description}" Style="{StaticResource BodyText}" Margin="0,0,0,28"/>

                        <!-- Language Selection -->
                        <TextBlock Text="Language" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                            <!-- SUB Button -->
                            <Button Margin="0,0,8,0"
                                    Command="{Binding SelectSubCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="Padding" Value="24,9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="SUB" FontSize="13"/>
                            </Button>

                            <!-- DUB Button -->
                            <Button Command="{Binding SelectDubCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="Padding" Value="24,9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDubSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrandSecondaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandSecondaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="DUB" FontSize="13"/>
                            </Button>
                        </StackPanel>

                        <!-- Episodes -->
                        <TextBlock Text="Episodes" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding Episodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Number, StringFormat='{}{0:D2}'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Duration}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0">
                                                <Border Style="{StaticResource SubBadge}"
                                                        Visibility="{Binding HasSub, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="SUB" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                                </Border>
                                                <Border Style="{StaticResource DubBadge}"
                                                        Visibility="{Binding HasDub, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="DUB" FontSize="10" FontWeight="Bold" Foreground="#EC4899"/>
                                                </Border>
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource SmallButton}"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource BrandPrimaryBrush}"
                                                    BorderBrush="{StaticResource BrandPrimaryBrush}"
                                                    BorderThickness="1"
                                                    Command="{Binding DataContext.AddEpisodeToQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="+ Queue" FontSize="11"/>
                                            </Button>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource SmallButton}"
                                                    Command="{Binding DataContext.DownloadEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Download" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <!-- Right Panel -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Border Style="{StaticResource CardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding AddEpisodeToQueueCommand}">
                                    <TextBlock Text="+ Add All to Queue"/>
                                </Button>
                                <Separator Style="{StaticResource HrSeparator}" Margin="0,12"/>
                                <TextBlock Text="SELECTED LANGUAGE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedLanguage}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource BrandPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Height="40"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
