<UserControl x:Class="NimeVault.Views.AnimeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="LangBtn" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="28,10"/>
        </Style>
        <Style x:Key="LangBtnActive" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#7C3AED" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,48">
        <StackPanel>

            <!-- Loading -->
            <Border Height="320" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15"/>
            </Border>

            <!-- Content -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">

                <!-- Hero -->
                <Grid MinHeight="420" Visibility="{Binding Anime, Converter={StaticResource NullToVisibility}}">
                    <Border ClipToBounds="True">
                        <Image Source="{Binding Anime.BackgroundUrl}" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Border>
                    <!-- Gradient overlay -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33000000" Offset="0"/>
                                <GradientStop Color="#F00F1117" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Back Button -->
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding GoBackCommand}"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="40,18,0,0" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Poster + Info -->
                    <Grid Margin="40,0,40,32" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="130" Height="182" CornerRadius="10" ClipToBounds="True" Margin="0,0,28,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="18" ShadowDepth="6"/>
                            </Border.Effect>
                            <Image Source="{Binding Anime.PosterUrl}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Anime.Title}" Foreground="White"
                                       FontSize="32" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="6" ShadowDepth="1"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding Anime.AlternativeTitle}"
                                       Foreground="#94A3B8" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" Background="#22FFFFFF">
                                    <TextBlock Text="{Binding Anime.Year}" Foreground="#CBD5E1" FontSize="12"/>
                                </Border>
                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" Background="#22FFFFFF">
                                    <TextBlock Text="{Binding Anime.Status}" Foreground="#CBD5E1" FontSize="12"/>
                                </Border>
                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0" Background="#22F59E0B">
                                    <TextBlock Text="{Binding Anime.Rating, Converter={StaticResource RatingToStars}}"
                                               Foreground="#F59E0B" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <Border CornerRadius="4" Padding="8,3" Background="#22FFFFFF">
                                    <TextBlock Text="{Binding Anime.TotalEpisodes, StringFormat='{}{0} Episodes'}"
                                               Foreground="#CBD5E1" FontSize="12"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Anime.Genres, Converter={StaticResource GenreListToString}}"
                                       Foreground="#A78BFA" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Details Section -->
                <Grid Margin="40,28,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0" Margin="0,0,32,0">

                        <!-- About -->
                        <TextBlock Text="About" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Anime.Description}" Style="{StaticResource BodyText}" Margin="0,0,0,32"/>

                        <!-- Language Selection -->
                        <TextBlock Text="Language" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                            <Button Margin="0,0,10,0" Command="{Binding SelectSubCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="Padding" Value="28,10"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#7C3AED" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="SUB" FontSize="13"/>
                            </Button>
                            <Button Command="{Binding SelectDubCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="Padding" Value="28,10"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDubSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrandSecondaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandSecondaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#EC4899" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="DUB" FontSize="13"/>
                            </Button>
                        </StackPanel>

                        <!-- Episodes -->
                        <TextBlock Text="Episodes" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding Episodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverCardStyle}" Margin="0,0,0,7" Padding="18,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Number, StringFormat='{}{0:D2}'}"
                                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                                       FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Duration}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0">
                                                <Border Style="{StaticResource SubBadge}"
                                                        Visibility="{Binding HasSub, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="SUB" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                                </Border>
                                                <Border Style="{StaticResource DubBadge}"
                                                        Visibility="{Binding HasDub, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="DUB" FontSize="10" FontWeight="Bold" Foreground="#EC4899"/>
                                                </Border>
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource SmallButton}"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource BrandPrimaryBrush}"
                                                    BorderBrush="{StaticResource BrandPrimaryBrush}"
                                                    BorderThickness="1"
                                                    Command="{Binding DataContext.AddEpisodeToQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="+ Queue" FontSize="11"/>
                                            </Button>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource SmallButton}"
                                                    Command="{Binding DataContext.DownloadEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Download" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Right Panel -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Border Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding AddAllToQueueCommand}">
                                    <TextBlock Text="+ Add All to Queue" FontSize="13"/>
                                </Button>
                                <Separator Style="{StaticResource HrSeparator}" Margin="0,14"/>
                                <TextBlock Text="SELECTED LANGUAGE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedLanguage}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource BrandPrimaryBrush}"/>
                                <Separator Style="{StaticResource HrSeparator}" Margin="0,14"/>
                                <TextBlock Text="TOTAL EPISODES" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Anime.TotalEpisodes}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Height="40"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
