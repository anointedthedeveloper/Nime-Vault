<Application x:Class="NimeVault.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NimeVault.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:StringToVisibilityConverter      x:Key="StringToVisibility"/>
            <conv:RatingToStarsConverter           x:Key="RatingToStars"/>
            <conv:GenreListToStringConverter       x:Key="GenreListToString"/>
            <conv:DownloadStatusToColorConverter   x:Key="DownloadStatusToColor"/>
            <conv:DownloadStatusToTextConverter    x:Key="DownloadStatusToText"/>
            <conv:NullToVisibilityConverter        x:Key="NullToVisibility"/>
            <conv:NonZeroToVisibilityConverter     x:Key="NonZeroToVisibility"/>
            <conv:BoolToActiveNavConverter         x:Key="BoolToActiveNav"/>
            <conv:ThemeToggleTipConverter          x:Key="ThemeToggleTip"/>
            <conv:EqualityConverter               x:Key="EqualityToVisibility"/>
            <conv:HttpImageConverter              x:Key="HttpImage"/>
            <conv:BgWithFallbackConverter          x:Key="BgWithFallback"/>

            <!-- Shared shadow effect (used by toast cards, posters, etc.) -->
            <DropShadowEffect x:Key="ToastShadow"
                              Color="Black" Opacity="0.12"
                              BlurRadius="12" ShadowDepth="2"/>
            <DropShadowEffect x:Key="CardShadow"
                              Color="Black" Opacity="0.08"
                              BlurRadius="8" ShadowDepth="1"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
